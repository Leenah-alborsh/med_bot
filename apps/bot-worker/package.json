{
  "name": "@medical/bot-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -e ../../.env.example -- tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e ../../.env -e ../../.env.example -- node dist/src/main.js",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@medical/database": "workspace:^",
    "@medical/shared": "workspace:*",
    "grammy": "^1.33.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@medical/config": "workspace:*",
    "dotenv-cli": "^7.4.4",
    "tsx": "^4.19.2"
  }
}
