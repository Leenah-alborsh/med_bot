generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("NEON_DIRECT_URL")
}

enum BotGroupType {
  ALL_YEARS
  PRECLINICAL
  CLINICAL
}

enum ContentType {
  TEXT
  LINK
  FILE
}

enum PublicationState {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StorageProvider {
  LOCAL
  TELEGRAM
  EXTERNAL_URL
}

enum ContentAccessEventType {
  VIEW
  OPEN_LINK
  DOWNLOAD_REQUEST
}

enum BrokenFileReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum BotStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AdminStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum AdminSetupTokenPurpose {
  ACCOUNT_SETUP
  PASSWORD_RESET
}

model Bot {
  id               String                 @id @default(uuid()) @db.Uuid
  key              String                 @unique
  displayName      String
  telegramUsername String?
  tokenReference   String?
  groupType        BotGroupType
  status           BotStatus              @default(DRAFT)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  yearVisibility   AcademicYearBot[]
  memberships      StudentBotMembership[]
  adminScopes      AdminScope[]

  @@index([groupType, status])
}

model Student {
  id                     String                 @id @default(uuid()) @db.Uuid
  telegramUserId         BigInt                 @unique
  username               String?
  firstName              String?
  lastName               String?
  preferredLanguage      String                 @default("ar")
  selectedAcademicYearId String?                @db.Uuid
  isBlocked              Boolean                @default(false)
  firstSeenAt            DateTime               @default(now())
  lastSeenAt             DateTime               @default(now())
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  selectedAcademicYear   AcademicYear?          @relation(fields: [selectedAcademicYearId], references: [id], onDelete: SetNull)
  memberships            StudentBotMembership[]
  accessEvents           ContentAccessEvent[]
  brokenFileReports      BrokenFileReport[]

  @@index([telegramUserId])
  @@index([selectedAcademicYearId])
  @@index([firstSeenAt])
  @@index([lastSeenAt])
}

model StudentBotMembership {
  id                          String               @id @default(uuid()) @db.Uuid
  studentId                   String               @db.Uuid
  botId                       String               @db.Uuid
  firstSeenAt                 DateTime             @default(now())
  lastInteraction             DateTime             @default(now())
  isBlocked                   Boolean              @default(false)
  navigationLevel             String               @default("STAGE")
  navigationStage             Int?
  navigationYearId            String?              @db.Uuid
  navigationSemesterId        String?              @db.Uuid
  navigationCourseId          String?              @db.Uuid
  navigationSectionId         String?              @db.Uuid
  navigationContentType       String?
  navigationContentCategoryId String?              @db.Uuid
  navigationContentCategory   ContentCategory?     @relation(fields: [navigationContentCategoryId], references: [id], onDelete: SetNull)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  student                     Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bot                         Bot                  @relation(fields: [botId], references: [id], onDelete: Cascade)
  accessEvents                ContentAccessEvent[]

  @@unique([studentId, botId])
  @@index([botId, isBlocked])
  @@index([navigationLevel])
  @@index([lastInteraction])
}

model AcademicYear {
  id            String            @id @default(uuid()) @db.Uuid
  number        Int               @unique
  nameAr        String
  nameEn        String
  isActive      Boolean           @default(true)
  displayOrder  Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  archivedAt    DateTime?
  botVisibility AcademicYearBot[]
  semesters     Semester[]
  students      Student[]
  adminScopes   AdminScope[]

  @@index([isActive, displayOrder])
}

model AcademicYearBot {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @db.Uuid
  botId          String       @db.Uuid
  createdAt      DateTime     @default(now())
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  bot            Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, botId])
  @@index([botId])
}

model Semester {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @db.Uuid
  nameAr         String
  nameEn         String
  displayOrder   Int
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  archivedAt     DateTime?
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  courses        Course[]

  @@unique([academicYearId, displayOrder])
  @@index([isActive, displayOrder])
}

model Course {
  id            String       @id @default(uuid()) @db.Uuid
  semesterId    String       @db.Uuid
  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?
  displayOrder  Int
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  archivedAt    DateTime?
  semester      Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sections      Section[]
  adminScopes   AdminScope[]

  @@index([semesterId, isActive, displayOrder])
}

model Section {
  id                String            @id @default(uuid()) @db.Uuid
  courseId          String            @db.Uuid
  parentId          String?           @db.Uuid
  nameAr            String
  nameEn            String
  displayOrder      Int
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  archivedAt        DateTime?
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent            Section?          @relation("SectionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children          Section[]         @relation("SectionHierarchy")
  contentItems      ContentItem[]
  contentCategories ContentCategory[]

  @@index([courseId, parentId, isActive, displayOrder])
}

model ContentCategory {
  id           String                 @id @default(uuid()) @db.Uuid
  sectionId    String                 @db.Uuid
  nameAr       String
  nameEn       String
  displayOrder Int
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  archivedAt   DateTime?
  section      Section                @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  contentItems ContentItem[]
  memberships  StudentBotMembership[]

  @@unique([sectionId, displayOrder])
  @@index([sectionId, isActive, displayOrder])
}

model AdminUser {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique
  passwordHash        String?
  telegramUserId      BigInt?             @unique
  displayNameAr       String
  displayNameEn       String
  status              AdminStatus         @default(PENDING)
  mustChangePassword  Boolean             @default(true)
  lastLoginAt         DateTime?
  failedLoginCount    Int                 @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  roles               AdminRole[]
  scopes              AdminScope[]
  auditLogs           AuditLog[]
  sessions            AdminSession[]
  setupTokens         AdminSetupToken[]
  createdContent      ContentItem[]       @relation("ContentCreatedBy")
  updatedContent      ContentItem[]       @relation("ContentUpdatedBy")
  uploadedAttachments ContentAttachment[] @relation("AttachmentUploadedBy")
  reviewedReports     BrokenFileReport[]  @relation("ReportReviewedBy")

  @@index([status])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  nameAr      String
  nameEn      String
  description String?
  isSystem    Boolean          @default(false)
  isProtected Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  admins      AdminRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  labelAr     String
  labelEn     String
  isReserved  Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model AdminRole {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  roleId      String    @db.Uuid
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([adminUserId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
}

model AdminScope {
  id             String        @id @default(uuid()) @db.Uuid
  adminUserId    String        @db.Uuid
  botId          String?       @db.Uuid
  academicYearId String?       @db.Uuid
  courseId       String?       @db.Uuid
  createdAt      DateTime      @default(now())
  adminUser      AdminUser     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  bot            Bot?          @relation(fields: [botId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, botId, academicYearId, courseId])
  @@index([botId])
  @@index([academicYearId])
  @@index([courseId])
}

model AuditLog {
  id         String     @id @default(uuid()) @db.Uuid
  actorId    String?    @db.Uuid
  actionKey  String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime   @default(now())
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([actionKey, createdAt])
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  tokenHash   String    @unique
  csrfHash    String
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AdminSetupToken {
  id          String                 @id @default(uuid()) @db.Uuid
  adminUserId String                 @db.Uuid
  tokenHash   String                 @unique
  purpose     AdminSetupTokenPurpose @default(ACCOUNT_SETUP)
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime               @default(now())
  adminUser   AdminUser              @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, purpose, expiresAt])
}

model ContentItem {
  id                String               @id @default(uuid()) @db.Uuid
  sectionId         String               @db.Uuid
  contentCategoryId String               @db.Uuid
  titleAr           String
  titleEn           String?
  descriptionAr     String?
  descriptionEn     String?
  bodyText          String?
  contentType       ContentType
  state             PublicationState     @default(DRAFT)
  isActive          Boolean              @default(true)
  displayOrder      Int
  publishedAt       DateTime?
  archivedAt        DateTime?
  createdById       String               @db.Uuid
  updatedById       String               @db.Uuid
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  section           Section              @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  contentCategory   ContentCategory      @relation(fields: [contentCategoryId], references: [id], onDelete: Restrict)
  createdBy         AdminUser            @relation("ContentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         AdminUser            @relation("ContentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  attachments       ContentAttachment[]
  accessEvents      ContentAccessEvent[]
  reports           BrokenFileReport[]

  @@unique([contentCategoryId, displayOrder])
  @@index([sectionId, state, isActive, displayOrder])
  @@index([contentCategoryId, state, isActive, displayOrder])
  @@index([contentType, state])
}

model ContentAttachment {
  id                   String             @id @default(uuid()) @db.Uuid
  contentItemId        String             @db.Uuid
  storageProvider      StorageProvider
  originalFilename     String
  storedPath           String?
  externalUrl          String?
  telegramFileId       String?
  telegramFileUniqueId String?
  storageChatId        BigInt?
  storageMessageId     Int?
  mimeType             String
  fileSize             BigInt
  checksum             String?
  version              Int                @default(1)
  isCurrent            Boolean            @default(true)
  archivedAt           DateTime?
  uploadedById         String?            @db.Uuid
  createdAt            DateTime           @default(now())
  contentItem          ContentItem        @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  uploadedBy           AdminUser?         @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  reports              BrokenFileReport[]

  @@unique([contentItemId, checksum])
  @@index([contentItemId, storageProvider])
  @@index([contentItemId, isCurrent, version])
}

model ContentAccessEvent {
  id              String                 @id @default(uuid()) @db.Uuid
  studentId       String                 @db.Uuid
  contentItemId   String                 @db.Uuid
  botMembershipId String?                @db.Uuid
  eventType       ContentAccessEventType
  createdAt       DateTime               @default(now())
  student         Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  contentItem     ContentItem            @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  botMembership   StudentBotMembership?  @relation(fields: [botMembershipId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([contentItemId, eventType, createdAt])
}

model TelegramWebhookUpdate {
  updateId    BigInt    @id
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([processedAt, receivedAt])
}

model BrokenFileReport {
  id             String                 @id @default(uuid()) @db.Uuid
  studentId      String                 @db.Uuid
  contentItemId  String                 @db.Uuid
  attachmentId   String?                @db.Uuid
  reasonCategory String?
  status         BrokenFileReportStatus @default(OPEN)
  reviewedById   String?                @db.Uuid
  reviewedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime               @default(now())
  student        Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  contentItem    ContentItem            @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  attachment     ContentAttachment?     @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  reviewedBy     AdminUser?             @relation("ReportReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([studentId, contentItemId, createdAt])
}
